#!/usr/bin/env python3
"""
ETL Shell - Interactive development environment for the Garmin Swimming Analyzer.

This script provides an interactive command-line interface for running ETL jobs,
inspecting data, and managing the pipeline.

Usage:
    ./etl-shell
"""

import sys
from pathlib import Path

# Add src to Python path
project_root = Path(__file__).parent.parent
src_path = project_root / "src"
sys.path.insert(0, str(src_path))

# Import and run the shell
from garmingo.cli.shell import ETLShell

if __name__ == "__main__":
    shell = ETLShell()
    shell.run()
